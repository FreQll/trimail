{
  "name": "trimail",
  "version": "1.0.0",
  "description": "Library for parsing email threads and removing quoted or repeated reply content.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "email",
    "trim",
    "quoted",
    "repeated",
    "hidden",
    "signature",
    "quotes",
    "gmail",
    "outlook",
    "parser",
    "thread",
    "reply",
    "strip",
    "clean",
    "apple-mail",
    "protonmail",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreQll/trimail"
  },
  "homepage": "https://github.com/FreQll/trimail#readme",
  "author": {
    "name": "Danylo Shchepin",
    "email": "shchepin.man@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-html-parser": "^7.0.2"
  }
}
